{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "تشغيل الخادم المحلي (localhost:5500)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\serve.ps1",
        "-Port",
        "5500"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "فتح الموقع في المتصفح",
      "type": "shell",
      "command": "start",
      "args": ["http://localhost:5500/index.html"],
      "windows": {
        "command": "cmd",
        "args": ["/c", "start", "http://localhost:5500/index.html"]
      },
      "problemMatcher": []
    }
  ]
}
